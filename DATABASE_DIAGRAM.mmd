
erDiagram
    %% ==========================================
    %% SAAS TENANT AND FACILITY
    %% ==========================================

    TENANTS ||--o{ FACILITIES : owns
    TENANTS ||--o{ USERS : employs
    TENANTS ||--o{ PATIENTS : owns
    TENANTS ||--o{ VISITS : records
    TENANTS ||--o{ AUDIT_LOGS : records
    TENANTS ||--o{ VISIT_COUNTERS : maintains
    TENANTS ||--o{ KIOSK_DEVICES : registers
    FACILITIES ||--o{ DEPARTMENTS : contains
    FACILITIES ||--o{ VISITS : hosts
    FACILITIES ||--o{ VISIT_COUNTERS : maintains
    FACILITIES ||--o{ KIOSK_DEVICES : operates

    %% ==========================================
    %% USERS AND PATIENTS
    %% ==========================================

    USERS o|--o| PATIENTS : patient_account

    %% ==========================================
    %% CLINIC ORGANIZATION
    %% ==========================================

    DEPARTMENTS ||--o{ STATIONS : contains
    DEPARTMENTS ||--o{ WORKFLOWS : configures
    WORKFLOWS ||--|{ WORKFLOW_STEPS : defines
    STATIONS ||--o{ WORKFLOW_STEPS : assigned_to

    %% ==========================================
    %% PATIENT VISITS
    %% ==========================================

    PATIENTS o|--o{ VISITS : has
    DEPARTMENTS ||--o{ VISITS : receives
    WORKFLOWS ||--o{ VISITS : follows

    %% ==========================================
    %% INTAKE AND QUEUE
    %% ==========================================

    VISITS ||--o{ QUEUE_ACQUISITIONS : acquires
    DEPARTMENTS ||--o{ QUEUE_ACQUISITIONS : receives

    VISITS ||--o{ QUEUE_TICKETS : generates
    WORKFLOW_STEPS ||--o{ QUEUE_TICKETS : processes
    STATIONS ||--o{ QUEUE_TICKETS : serves

    QUEUE_TICKETS ||--o{ QUEUE_EVENTS : records
    QUEUE_TICKETS o|--o{ QUEUE_TICKETS : transfers_from

    %% ==========================================
    %% REFERRALS
    %% ==========================================

    VISITS ||--o{ REFERRALS : source_visit
    DEPARTMENTS ||--o{ REFERRALS : target_department
    VISITS o|--o{ REFERRALS : target_visit

    %% ==========================================
    %% QUEUE COUNTERS
    %% ==========================================

    STATIONS ||--o{ QUEUE_COUNTERS : maintains

    %% ==========================================
    %% AUDIT
    %% ==========================================

    %% AUDIT_LOGS references actor and entity polymorphically.
    %% These are intentionally not shown as strict FK relationships.

    %% ==========================================
    %% SAAS BILLING
    %% ==========================================

    PLANS ||--o{ PLAN_PRICES : offers
    PLANS ||--o{ PLAN_ENTITLEMENTS : defines
    TENANTS ||--o{ SUBSCRIPTIONS : subscribes
    PLANS ||--o{ SUBSCRIPTIONS : selected_for
    PLAN_PRICES o|--o{ SUBSCRIPTIONS : priced_by
    SUBSCRIPTIONS ||--o{ PAYMENTS : receives
    BILLING_WEBHOOK_EVENTS }o--o| SUBSCRIPTIONS : relates_to

    %% ==========================================
    %% ENTITY DEFINITIONS
    %% ==========================================

    TENANTS {
        bigint id PK
        string name
        string slug UK
        string status
        string timezone
        json settings
        timestamp created_at
        timestamp updated_at
    }

    FACILITIES {
        bigint id PK
        bigint tenant_id FK
        string name
        string code
        string address
        boolean is_active
        timestamp created_at
        timestamp updated_at
    }

    USERS {
        bigint id PK
        bigint tenant_id FK "nullable for platform accounts"
        string account_type
        string role
        bigint department_id FK
        bigint station_id FK
        string name
        string email UK
        string password
    }

    PATIENTS {
        bigint id PK
        bigint tenant_id FK
        bigint user_id FK "nullable"
        string mrn
        string nik
        string name
        date birth_date
    }

    DEPARTMENTS {
        bigint id PK
        bigint facility_id FK
        string code
        string name
        boolean is_active
        boolean display_in_kiosk
    }

    STATIONS {
        bigint id PK
        bigint department_id FK
        string name
        string queue_prefix
        boolean is_active
    }

    WORKFLOWS {
        bigint id PK
        bigint department_id FK
        string name
        boolean is_primary
        boolean is_active
    }

    WORKFLOW_STEPS {
        bigint id PK
        bigint workflow_id FK
        bigint station_id FK
        integer sequence
        boolean is_optional
        boolean is_active
    }

    VISITS {
        bigint id PK
        bigint tenant_id FK
        bigint facility_id FK
        bigint patient_id FK "nullable"
        bigint department_id FK
        bigint workflow_id FK
        string visit_number
        uuid visit_token UK
        string status
        string intake_channel
    }

    QUEUE_ACQUISITIONS {
        bigint id PK
        bigint visit_id FK
        bigint department_id FK
        string channel
        string status
        string idempotency_key
    }

    QUEUE_TICKETS {
        bigint id PK
        bigint visit_id FK
        bigint workflow_step_id FK
        bigint station_id FK
        bigint transferred_from_ticket_id FK
        string queue_number
        string status
    }

    QUEUE_EVENTS {
        bigint id PK
        bigint queue_ticket_id FK
        string event_type
        string from_status
        string to_status
        string user_id
        json payload
    }

    REFERRALS {
        bigint id PK
        bigint source_visit_id FK
        bigint target_department_id FK
        bigint target_visit_id FK
        string referred_by_user_id
        string status
        string reason
    }

    QUEUE_COUNTERS {
        bigint id PK
        bigint station_id FK
        date counter_date
        integer last_sequence
    }

    VISIT_COUNTERS {
        bigint id PK
        bigint tenant_id FK
        bigint facility_id FK
        date counter_date
        integer last_sequence
    }

    AUDIT_LOGS {
        bigint id PK
        bigint tenant_id FK "nullable for platform"
        string user_id
        string action
        string entity_type
        string entity_id
        json metadata
        string ip_address
    }

    KIOSK_DEVICES {
        bigint id PK
        bigint tenant_id FK
        bigint facility_id FK
        string name
        string device_token_hash
        boolean is_active
        timestamp last_seen_at
    }

    PLANS {
        bigint id PK
        string code UK
        string name
        text description
        boolean is_active
    }

    PLAN_PRICES {
        bigint id PK
        bigint plan_id FK
        string billing_interval
        bigint amount
        string currency
        boolean is_active
    }

    PLAN_ENTITLEMENTS {
        bigint id PK
        bigint plan_id FK
        string feature_code
        json value
    }

    SUBSCRIPTIONS {
        bigint id PK
        bigint tenant_id FK
        bigint plan_id FK
        bigint plan_price_id FK
        string status
        string billing_interval
        string provider
        timestamp current_period_start
        timestamp current_period_end
        timestamp trial_ends_at
    }

    PAYMENTS {
        bigint id PK
        bigint subscription_id FK
        string provider
        string provider_transaction_id
        bigint amount
        string currency
        string status
        timestamp paid_at
        json metadata
    }

    BILLING_WEBHOOK_EVENTS {
        bigint id PK
        string provider
        string event_id
        string event_type
        json payload
        timestamp processed_at
    }
