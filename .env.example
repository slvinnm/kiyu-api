APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# Never enable in production: debug pages disclose configuration and traces.
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Minutes a Sanctum API token stays valid after login.
AUTH_TOKEN_TTL_MINUTES=480

# Comma-separated browser origins allowed to call the API. Leave empty to
# reject all cross-origin browser calls (same-origin and non-browser clients
# are unaffected).
CORS_ALLOWED_ORIGINS=

# Laravel Boost registers a public POST /_boost/browser-logs route whenever
# it is enabled and the app runs in local or with APP_DEBUG=true. Keep this
# false anywhere that is not a developer machine.
BOOST_BROWSER_LOGS_WATCHER=false

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kiyu
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=kiyu
REVERB_APP_KEY=kiyu-app-key
REVERB_APP_SECRET=kiyu-app-secret
REVERB_HOST=kiyu.test
REVERB_PORT=6001
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=6001
REVERB_PUBLISH_HOST=127.0.0.1
REVERB_PUBLISH_PORT=6001
REVERB_PUBLISH_SCHEME=http

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Midtrans payment gateway (Snap). Sandbox base by default; use
# https://app.midtrans.com/snap/v1 and a production server key to go live.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SNAP_BASE=https://app.sandbox.midtrans.com/snap/v1
MIDTRANS_TIMEOUT=15

WHATSAPP_ENABLED=false
WHATSAPP_ENDPOINT=
WHATSAPP_METHOD=POST
WHATSAPP_TIMEOUT=15
WHATSAPP_TOKEN=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ENCRYPTION=null

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY=kiyu-app-key
VITE_REVERB_HOST=kiyu.test
VITE_REVERB_PORT=6001
VITE_REVERB_SCHEME=https